# Keep verified registry files untouched; compile a patched build copy.
idf_component_get_property(network_dir 78__esp-ml307 COMPONENT_DIR)
idf_component_get_property(network_lib 78__esp-ml307 COMPONENT_LIB)
set(repair "${CMAKE_CURRENT_LIST_DIR}/../patches/esp-ml307-receive-task.patch")
set(staging "${CMAKE_BINARY_DIR}/phosphor-network")
file(MAKE_DIRECTORY "${staging}/src/esp")
configure_file("${network_dir}/src/esp/esp_tcp.cc" "${staging}/src/esp/esp_tcp.cc" COPYONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${repair}")
find_program(PATCH_PROGRAM patch REQUIRED)
execute_process(COMMAND "${PATCH_PROGRAM}" --batch --fuzz=0 -p1 -i "${repair}"
                WORKING_DIRECTORY "${staging}" RESULT_VARIABLE patch_status)
if(NOT patch_status EQUAL 0)
    message(FATAL_ERROR "Pinned network source no longer matches the PHOSPHOR repair")
endif()
get_target_property(network_sources "${network_lib}" SOURCES)
list(LENGTH network_sources original_count)
list(FILTER network_sources EXCLUDE REGEX "(^|/)src/esp/esp_tcp[.]cc$")
list(LENGTH network_sources retained_count)
math(EXPR expected_count "${original_count} - 1")
if(NOT retained_count EQUAL expected_count)
    message(FATAL_ERROR "Expected one TCP implementation to replace")
endif()
set_property(TARGET "${network_lib}" PROPERTY SOURCES "${network_sources};${staging}/src/esp/esp_tcp.cc")
target_include_directories("${network_lib}" PRIVATE "${network_dir}/src/esp")
